        },
        {
            "header": "Trans Mode", "unit": "", "canId": "0x3FD",
            "offset": 2, "length": 1, "dec": 0,
            "stringLut": [
                { "x": 32, "y": "P" }, { "x": 64, "y": "R" }, { "x": 96, "y": "N" },
                { "x": 128, "y": "D" }, { "x": 129, "y": "DS/M" }
            ]
        },
        {
            "header": "Terminal State", "unit": "", "canId": "0x12F",
            "offset": 2, "length": 1, "expr": "x & 15", "dec": 0,
            "stringLut": [
                { "x": 0, "y": "Init" }, { "x": 1, "y": "Reserved" },
                { "x": 2, "y": "KL30" }, { "x": 3, "y": "KL30F transition" },
                { "x": 4, "y": "KL30F on" }, { "x": 5, "y": "KL30B transition" },
                { "x": 6, "y": "KL30B on" }, { "x": 7, "y": "KLR transition" },
                { "x": 8, "y": "KLR on" }, { "x": 9, "y": "KL15 transition" },
                { "x": 10, "y": "KL15 on" }, { "x": 11, "y": "KL50 delay" },
                { "x": 12, "y": "KL50 transition" }, { "x": 13, "y": "KL50 on" },
                { "x": 14, "y": "Error" }, { "x": 15, "y": "Unavailable" }
            ]
        },
        {
            "header": "Fuel", "unit": "L", "canId": "0x349",
            "offset": 2, "length": 2, "mul": 1, "dec": 0, "reverseEndianess": true
        },
        {
            "header": "High Beam", "unit": "", "canId": "0x21A",
            "offset": 0, "length": 1, "expr": "(x & 0x02) >> 1", "dec": 0
        },
        {
            "header": "Main Lights", "unit": "", "canId": "0x21A",
            "offset": 0, "length": 1, "expr": "(x & 0x04) >> 2", "dec": 0
        },
        {
            "header": "Front Fog", "unit": "", "canId": "0x21A",
            "offset": 0, "length": 1, "expr": "(x & 0x20) >> 5", "dec": 0
        },
        {
            "header": "Rear Fog", "unit": "", "canId": "0x21A",
            "offset": 0, "length": 1, "expr": "(x & 0x40) >> 6", "dec": 0
        },
        {
            "header": "Left Blinker", "unit": "", "canId": "0x1F6",
            "offset": 0, "length": 1, "expr": "(x & 0x10) >> 4", "dec": 0
        },
        {
            "header": "Right Blinker", "unit": "", "canId": "0x1F6",
            "offset": 0, "length": 1, "expr": "(x & 0x20) >> 5", "dec": 0
        },
        {
            "header": "Backlight Brightness", "unit": "%", "canId": "0x202",
            "offset": 0, "length": 1, "mul": 0.3953, "dec": 0,
            "hidden": true, "noLog": true
        },
        {
            "header": "Brightness", "expr": "setBrightness(x)", "x": "Backlight Brightness",
            "hidden": true, "noLog": true
        },
        {
            "header": "Drive Mode", "unit": "", "canId": "0x3A7",
            "offset": 4, "length": 1, "dec": 0,
            "stringLut": [
                { "x": 1, "y": "Traction" }, { "x": 2, "y": "Comfort" },
                { "x": 4, "y": "Sport" }, { "x": 5, "y": "Sport+" },
                { "x": 6, "y": "DSC off" }, { "x": 7, "y": "Eco pro" }
            ]
        },
        {
            "header": "Steering Wheel Button", "canId": "0x1EE",
            "offset": 0, "length": 1, "expr": "buttonPress(0, 0, (x) == 76, 0)",
            "hidden": true, "noLog": true
        },
        {
            "header": "Engine Speed", "unit": "RPM", "canId": "0xA5",
            "offset": 5, "length": 2, "mul": 0.25, "dec": 0
        },
        {
            "header": "Torque", "unit": "Nm", "canId": "0xA5",
            "offset": 2, "length": 2, "expr": "(x & 0x0FFF)*0.5-1023.5", "dec": 1
        },
        {
            "header": "Torque Without EGS Intervention", "unit": "Nm", "canId": "0xA5",
            "offset": 3, "length": 2, "expr": "(x >> 4)*0.5-1023.5", "dec": 1
        },
        {
            "header": "Accelerator Pedal", "unit": "%", "canId": "0xD9",
            "offset": 2, "length": 2, "expr": "(x & 0x0FFF)*0.025", "dec": 1
        },
        {
            "header": "Virtual Accelerator Pedal", "unit": "%", "canId": "0xD9",
            "offset": 4, "length": 2, "expr": "(x & 0x0FFF)*0.025", "dec": 1
        },
        {
            "header": "Brake Pressure - Front", "unit": "Bar", "canId": "0xEF",
            "offset": 2, "length": 2, "expr": "(-3)*(x) / 200 + 480", "dec": 1
        },
        {
