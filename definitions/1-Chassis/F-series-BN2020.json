            "header": "Suggested Gear", "canId": "0xF3", "bit": 24, "bitLen": 4, "dec": 0,
            "stringLut": [ { "x": 0, "y": "Off" }, { "x": 1, "y": "" }, { "x": 15, "y": "Unavailable" } ]
        },
        {
            "header": "Shift Advice", "canId": "0xF3", "bit": 28, "bitLen": 2, "dec": 0,
            "stringLut": [
                { "x": 0, "y": "Off" }, { "x": 1, "y": "Downshift" },
                { "x": 2, "y": "Upshift" }, { "x": 3, "y": "Unavailable" }
            ]
        },
        { "header": "Fuel Counter Previous", "value": -1, "hidden": true, "noLog": true },
        { "header": "Fuel Counter Time", "value": -1, "hidden": true, "noLog": true },
        {
            // MEVD pp.1533–1534,5124–5125: cumulative microlitres, FFFF invalid.
            // 0x2C4 is absent on K-CAN2 in the examined F11 logs; use PT-CAN there.
            "header": "Fuel usage", "unit": "l/h", "canId": "0x2C4",
            "offset": 0, "length": 2,
            "expr": "y={Seconds}-{Fuel Counter Time}, z=(x==65535 || {Engine Speed}<=0 || {Fuel Counter Previous}<0 || y<0 || y>0.75 ? 0 : (y>0 ? ((x-{Fuel Counter Previous}+65536)%65536)*0.0036/y : {Fuel usage})), {Fuel Counter Previous}=(x==65535 || {Engine Speed}<=0 ? -1 : (y!=0 || {Fuel Counter Previous}<0 ? x : {Fuel Counter Previous})), {Fuel Counter Time}={Seconds}, z<=300 ? z : 0",
            "dec": 2
        }
    ]
