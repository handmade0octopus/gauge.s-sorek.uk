{
    "canSpeed": 500,
    // Shared F-series baseline (also commonly labelled BN2010).
    // Message availability depends on the bus/ECU: ../BMW-CHASSIS-NOTES.md
    "sleep": {
        // Deep sleep after 60s of no CAN traffic; wake on the 0x130 alive frame.
        // wakeupCode/wakeupMask = TWAI acceptance filter for ID 0x130 with
        // data0 = 0xFE/0xFF (alive frame) — proven on E9X/F-series, do not change.
        "sleepTime": 60,
        "wakeupCode": "0x2600FFFF",
        "wakeupMask": "0x2600FEFF"
    },
    "ecuparam": [
        {
            "header": "Can sleep", "canId": "0x130",
            "expr": "sleep((x & 1) == 0)", "length": 1,
            "hidden": true, "noLog": true
        },
        {
            "header": "Indicated Engine Speed", "unit": "RPM", "canId": "0xF3",
            "offset": 1, "length": 2, "expr": "(x >> 4)*10", "dec": 0
        },
        {
            "header": "Brake Light", "unit": "on/off", "canId": "0x173",
            "offset": 0, "length": 1,
            "expr": "(0.5)*((x & 0x18) >> 3) + (0)", "dec": 0
        },
        {
            "header": "Brake Position", "unit": "", "canId": "0x173",
            "offset": 7, "length": 1, "expr": "(1)*(x & 0x3F) + (0)", "dec": 0
        },
        {
            "header": "Indicated Longitudinal Acceleration", "unit": "g", "canId": "0x199",
            "offset": 2, "length": 2, "expr": "(-1)*(x) / 5000 + 6.6259", "dec": 3
        },
        {
            "header": "Indicated Lateral Acceleration", "unit": "g", "canId": "0x19A",
            "offset": 2, "length": 2, "expr": "(-1)*(x) / 5000 + 6.6259", "dec": 3
        },
        {
            "header": "Vehicle Speed", "unit": "km/h", "canId": "0x1A1",
            "offset": 2, "length": 2, "mul": 0.015625, "dec": 1
        },
        {
            "header": "Battery Current", "unit": "", "canId": "0x1BA",
            "offset": 3, "length": 2, "mul": 0.02, "add": -200, "dec": 1
        },
        {
            "header": "Wheel Angular Speed RL", "unit": "rad/s", "canId": "0x254",
            "offset": 0, "length": 2, "mul": 0.015625, "add": -511.984375, "dec": 2
        },
        {
            "header": "Wheel Angular Speed RR", "unit": "rad/s", "canId": "0x254",
            "offset": 2, "length": 2, "mul": 0.015625, "add": -511.984375, "dec": 2
        },
        {
            "header": "Wheel Angular Speed FL", "unit": "rad/s", "canId": "0x254",
            "offset": 4, "length": 2, "mul": 0.015625, "add": -511.984375, "dec": 2
        },
        {
            "header": "Wheel Angular Speed FR", "unit": "rad/s", "canId": "0x254",
            "offset": 6, "length": 2, "mul": 0.015625, "add": -511.984375, "dec": 2
        },
        {
            // Mask before scaling; retains the existing intended 15 mV/bit calibration.
            "header": "Battery Voltage", "unit": "V", "canId": "0x281",
            "offset": 0, "length": 2, "expr": "(x & 0x0FFF)*0.015", "dec": 2
        },
        {
            "header": "Air Temp", "unit": "°C", "canId": "0x2CA",
            "offset": 1, "length": 1, "mul": 0.5, "add": -40, "dec": 0
        },
        {
            "header": "Steering Angle", "unit": "", "canId": "0x301",
            "offset": 2, "length": 2, "mul": 0.04395, "add": -1440.11, "dec": 1
        },
        {
            // EGS variant; absent in the examined F11 captures.
            "header": "Transmission Oil Temp", "unit": "°C", "canId": "0x39A",
            "offset": 1, "length": 1, "add": -40, "dec": 0
        },
        {
            "header": "Oil Temp", "unit": "°C", "canId": "0x3F9",
            "offset": 5, "length": 1, "add": -48, "dec": 0
        },
        {
            "header": "Current Gear", "unit": "", "canId": "0x3F9",
            "offset": 6, "length": 1, "expr": "x & 15", "dec": 0,
            "stringLut": [
                { "x": 1, "y": "N" }, { "x": 2, "y": "R" }, { "x": 3, "y": "P" },
                { "x": 5, "y": "1" }, { "x": 6, "y": "2" }, { "x": 7, "y": "3" },
                { "x": 8, "y": "4" }, { "x": 9, "y": "5" }, { "x": 10, "y": "6" },
                { "x": 11, "y": "7" }, { "x": 12, "y": "8" }, { "x": 15, "y": "Unavailable" }
            ]
        },
        {
            "header": "Ambient Pressure", "unit": "Bar", "canId": "0x3FB",
