            "offset": 3, "length": 1, "expr": "(-2)*(x) + 250", "dec": 0
        },
        {
            "header": "Brake Pressure - Rear", "unit": "Bar", "canId": "0xEF",
            "offset": 5, "length": 2, "expr": "(-3)*(x) / 200 + 480", "dec": 1
        },
        {
            "header": "ABS", "unit": "#", "canId": "0x173",
            "offset": 3, "length": 2, "expr": "(1)*(x & 0x0FFF) + (0)", "dec": 0
        },
        {
            "header": "ASC", "unit": "#", "canId": "0x173",
            "offset": 5, "length": 2, "expr": "(1)*(x & 0x0FFF) + (0)", "dec": 0
        },
        {
            "header": "Vehicle Yaw Rate", "unit": "deg/s", "canId": "0x19F",
            "offset": 2, "length": 2, "expr": "(-1)*(x) / 200 + 163.84", "dec": 2
        },
        {
            "header": "High Beam Lamp ALT", "unit": "", "canId": "0x1EE",
            "offset": 0, "length": 1, "expr": "(1)*(x & 0x01) + (0)", "dec": 0
        },
        {
            "header": "Fuel Volume Counter", "unit": "µl", "canId": "0x2C4",
            "offset": 0, "length": 2, "dec": 0
        },
        {
            "header": "Ambient Temp ALT", "unit": "°C", "canId": "0x2CA",
            "offset": 0, "length": 1, "expr": "(1)*(x) / 2 + (-40)", "dec": 0
        },
        {
            "header": "Fuel Used", "unit": "liters", "canId": "0x330",
            "offset": 4, "length": 1, "expr": "(1)*(x) + (0)", "dec": 0
        },
        {
            "header": "Fuel Indicator Lamp", "unit": "", "canId": "0x330",
            "offset": 5, "length": 1, "expr": "(1)*(x & 0x01) + (0)", "dec": 0
        },
        {
            "header": "Fuel Range", "unit": "km", "canId": "0x330",
            "offset": 6, "length": 2, "expr": "(1)*(x & 0x0FFF) / 16 + (0)", "dec": 1
        },
        {
            // Variant-dependent byte; some MEVD software reserves it.
            "header": "Maximum RPM", "unit": "RPM", "canId": "0x3F9",
            "offset": 7, "length": 1, "mul": 50, "dec": 0
        },
        {
            "header": "Engine State", "canId": "0x3F9", "bit": 24, "bitLen": 2, "dec": 0,
            "stringLut": [
                { "x": 0, "y": "Off" }, { "x": 1, "y": "Starting" },
                { "x": 2, "y": "Running" }, { "x": 3, "y": "Unavailable" }
            ]
        },
        {
            "header": "Clutch State", "canId": "0x3F9", "bit": 26, "bitLen": 2, "dec": 0,
            "stringLut": [
                { "x": 0, "y": "Released" }, { "x": 1, "y": "Pressed" },
                { "x": 3, "y": "Unavailable" }
            ]
        },
        {
            "header": "Idle State", "canId": "0x3F9", "bit": 30, "bitLen": 2, "dec": 0,
            "stringLut": [
                { "x": 0, "y": "Idle" }, { "x": 1, "y": "Not idle" },
                { "x": 3, "y": "Unavailable" }
            ]
        },
        {
            "header": "Engine Warmup State", "canId": "0x3FB", "bit": 16, "bitLen": 2, "dec": 0,
            "stringLut": [
