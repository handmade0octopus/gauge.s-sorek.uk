{
    "canSpeed": 500,
    // Signal sources and economy state contract: ../BMW-CHASSIS-NOTES.md
    "ecuparam": [
        {
            "header": "Can button",
            "canId": "0x329",
            "offset": 3,
            "expr": "(x >> 5)",
            "hidden": false,
            "noLog": true
        },
        {
            // Legacy name retained for existing definitions and button bindings.
            "header": "Cruise active",
            "canId": "0x545",
            "expr": "(x & 8)",
            "offset": 0,
            "hidden": true,
            "noLog": true
        },
        {
            "header": "Button press",
            "unit": "b",
            "expr": "buttonPress(0, (x == 2) && !y, (x == 1) && !y, (x == 3) && !y)",
            "x": "Can button",
            "y": "Cruise active",
            "hidden": true,
            "noLog": true
        },
        {
            "header": "Speed CAN Raw",
            "canId": "0x153",
            "offset": 1,
            "length": 2,
            // Preserve the established raw scale and existing speed calibrations.
            "expr": "x >> 4"
        },
        {
            "header": "Engine Speed",
            "unit": "RPM",
            "canId": "0x316",
            "offset": 2,
            "length": 2,
            "mul": 0.15625,
            "dec": 0
        },
        {
            "header": "Coolant Temp",
            "unit": "°C",
            "canId": "0x329",
            "offset": 1,
            "mul": 0.75,
            "add": -48
        },
        {
            // Pedal signal; keep the established name used by gauges/helpers.
            "header": "Throttle Position",
            "unit": "%",
            "canId": "0x329",
            "offset": 5,
            "mul": 0.390625
        },
        {
            "header": "Oil Temp",
            "unit": "°C",
            "canId": "0x545",
            "offset": 4,
            "add": -48
        },
        {
            // Existing vehicle-specific polarity; pressed-high/P-N variants differ.
            "header": "Clutch",
            "canId": "0x329",
            "offset": 3,
            "expr": "!(x & 1)",
            "dec": 0
        },
        {
            "header": "Steering Angle",
            "unit": "deg",
            "canId": "0x1F5",
            "offset": 0,
            "length": 2,
            "expr": "(x > 32768)*((x-32768)*.044) + (x<32768)*(-.044*x)"
        },
        {
            "header": "Gear",
            "unit": "Byte",
            "canId": "0x1D2",
            "offset": 2,
            "length": 1,
            "dec": 0,
            "expr": "signed(x)",
            "stringLut": [
                { "x": 0.0, "y": "N" },
                { "x": 0.1, "y": "" }
            ]
        },
        {
            // https://www.ms4x.net/index.php?title=CAN_Bus_ID_0x615_ICL3
            "header": "Interior Night Lighting",
            "unit": "bool",
            "canId": "0x615",
            "offset": 1,
            "length": 1,
            "expr": "(x & 4) >> 2",
            "hidden": true,
            "noLog": true
        },
        {
            "header": "Brightness",
            "expr": "setBrightness(lutTable(\"Brightness\", x))",
            "x": "Interior Night Lighting",
            "lutTable": [
                { "x": 0, "y": 100 },
                { "x": 1, "y": 50 }
            ],
            "hidden": true,
            "noLog": true
        },
        {
            // https://www.ms4x.net/index.php?title=CAN_Bus_ID_0x613_ICL2
            "header": "Fuel Level",
            "unit": "L",
            "canId": "0x613",
            "offset": 2,
            "length": 1,
            "expr": "(x & 127)",
            "dec": 0
        },
        {
            "header": "Ambient Pressure", "unit": "Bar",
            "canId": "0x329", "offset": 2, "mul": 0.002, "add": 0.598, "dec": 3
        },
        { "header": "Brake", "canId": "0x329", "bit": 48, "bitLen": 1, "dec": 0 },
        { "header": "Brake Switch Error", "canId": "0x329", "bit": 49, "bitLen": 1, "dec": 0 },
        { "header": "Kickdown", "canId": "0x329", "bit": 50, "bitLen": 1, "dec": 0 },
        // Engine Running/Warm are initialization-only on some EDC software.
        { "header": "Engine Running", "canId": "0x329", "bit": 28, "bitLen": 1, "dec": 0 },
        { "header": "Engine Warm", "canId": "0x329", "bit": 27, "bitLen": 1, "dec": 0 },
        { "header": "Cruise Status", "canId": "0x329", "bit": 51, "bitLen": 3, "dec": 0 },
        { "header": "MIL", "canId": "0x545", "bit": 1, "bitLen": 1, "dec": 0 },
        { "header": "Engine Overtemperature", "canId": "0x545", "bit": 27, "bitLen": 1, "dec": 0 },
        { "header": "Fuel Reserve", "canId": "0x613", "bit": 23, "bitLen": 1, "dec": 0 },
        {
            "header": "Odometer", "unit": "km", "canId": "0x613",
            "offset": 0, "length": 2, "expr": "x==65535 ? {Odometer} : x*10", "dec": 0
        },
        { "header": "Fuel Counter Previous", "value": -1, "hidden": true, "noLog": true },
        { "header": "Fuel Counter Time", "value": -1, "hidden": true, "noLog": true },
        {
            // EDC p.363: cumulative microlitres, modulo 65536; FFFF is VALID here.
            // State updates only on RX. Rebase stopped/first/gap samples; see notes.
            "header": "Fuel usage",
            "unit": "l/h",
            "canId": "0x545",
            "offset": 1,
            "length": 2,
            "expr": "y={Seconds}-{Fuel Counter Time}, z=({Engine Speed}<=0 || {Fuel Counter Previous}<0 || y<0 || y>0.75 ? 0 : (y>0 ? ((x-{Fuel Counter Previous}+65536)%65536)*0.0036/y : {Fuel usage})), {Fuel Counter Previous}=({Engine Speed}<=0 ? -1 : (y!=0 || {Fuel Counter Previous}<0 ? x : {Fuel Counter Previous})), {Fuel Counter Time}={Seconds}, z<=300 ? z : 0",
            "dec": 2
        }
    ]
}
