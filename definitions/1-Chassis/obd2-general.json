{
    // Gauge.S processOBDResponse() supplies engineering values to expr directly.
    // JSON mul/add are not applied on that path. See ../BMW-CHASSIS-NOTES.md.
    // With a KWP ECU file, set its poll rate (e.g. 5–10 Hz) in filelist.json
    // to leave time for OBD replies; free-running KWP can starve these requests.
    "obdRefresh": 200,
    "canSpeed": 500,
    "ecuparam": [
        {
            "header": "Engine Speed", "unit": "RPM", "obdPID": 12,
            "max": 7000, "dec": 0
        },
        { "header": "MAP", "unit": "Bar", "obdPID": 11, "expr": "x*0.01" },
        { "header": "Lambda 1", "unit": "λ", "obdPID": 52, "min": 0.8, "max": 1.1 },
        { "header": "Torque Percent", "unit": "%", "obdPID": 98 },
        { "header": "Reference Torque", "unit": "Nm", "obdPID": 99, "eventsPerSecond": 0.1 },
        {
            "header": "Torque", "unit": "Nm",
            "x": "Torque Percent", "y": "Reference Torque", "expr": "x*y/100"
        },
        { "header": "Mass Airflow", "unit": "kg/h", "obdPID": 16, "expr": "x*3.6" },
        { "header": "Throttle Position", "unit": "%", "obdPID": 17 },
        { "header": "Ignition Angle", "unit": "°CRK", "obdPID": 14 },
        { "header": "Coolant Temp", "unit": "°C", "obdPID": 5, "eventsPerSecond": 0.1 },
        { "header": "Intake Air Temp", "unit": "°C", "obdPID": 15, "eventsPerSecond": 0.1 },
        { "header": "Oil Temp", "unit": "°C", "obdPID": 92, "eventsPerSecond": 0.1 },
        { "header": "Vehicle Speed", "unit": "km/h", "obdPID": 13 },
        { "header": "STFT 1", "unit": "%", "obdPID": 6 },
        { "header": "STFT 2", "unit": "%", "obdPID": 8 },
        { "header": "LTFT 1", "unit": "%", "obdPID": 7, "eventsPerSecond": 0.01 },
        { "header": "LTFT 2", "unit": "%", "obdPID": 9, "eventsPerSecond": 0.01 },
        { "header": "Input V", "alias": "Battery" },
        {
            "header": "Ambient Pressure", "unit": "Bar", "obdPID": 51,
            "expr": "x*0.01", "eventsPerSecond": 0.1, "dec": 3
        },
        { "header": "Battery Voltage", "unit": "V", "obdPID": 66, "eventsPerSecond": 1, "dec": 2 },
        // PID 0x5E is actual fuel rate in l/h, where supported by the ECU.
        { "header": "Fuel usage", "unit": "l/h", "obdPID": 94, "dec": 2 },
        {
            "header": "Boost", "unit": "Bar", "x": "MAP", "y": "Ambient Pressure",
            // Zero ambient means no response yet/unsupported; retain the 1 Bar fallback.
            "expr": "x-(y>0 ? y : 1)"
        }
    ]
}
