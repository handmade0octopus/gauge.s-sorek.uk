{
	// BMW E39 M5 (S62B50, MSS52) — K-line DS2.
	// Based on M3_E46.json (MSS54); layout + scaling verified against
	// EDIABAS PRG MSS52DS1.csv (telegram 12 05 0B 03, "BetriebswTab").
	// Differences vs M3_E46: Radiator Temp mul fixed (1, not 13), wrong
	// Ignition Angle entry removed (on MSS52 ignition angles live in a
	// separate telegram 12 05 0B 13), Idle Target + Rel Filling added.
	"canSpeed": 500,
	"address": ["0x12", "0x05", "0x0B", "0x03", "0x1F"],
	"ecuparam": [
		{
			"header": "Engine Speed",
			"unit": "RPM",
			"offset": 0,
			"length": 2,
			"max": 8000,
			"dec": 0
		},
		{
			"header": "Idle Target",
			"unit": "RPM",
			"offset": 2,
			"length": 2,
			"dec": 0
		},
		{
			"header": "Engine Load",
			"unit": "ms",
			"offset": 6,
			"length": 2,
			"mul": 0.001,
			"dec": 2
		},
		{
			"header": "Mass Airflow",
			"unit": "kg/h",
			"offset": 4,
			"length": 2,
			"mul": 0.25,
			"dec": 1
		},
		{
			"header": "Rel Filling",
			"unit": "%",
			"offset": 8,
			"length": 2,
			"mul": 0.1,
			"dec": 1
		},
		{
			"header": "Throttle Position",
			"unit": "%",
			"length": 2,
			"offset": 27,
			"mul": 0.1,
			"dec": 0			// Remember about this comma when editing line below
		//	"autoLogPoint": 60.0	// You can comment out or delete if you don't want to log on WOT.
		},
		{
			"header": "TPS Target",
			"unit": "%",
			"length": 2,
			"offset": 31,
			"mul": 0.1
		},
		{
			"header": "Intake Air Temp",
			"unit": "°C",
			"offset": 10,
			"mul": 1,
			"add": -48
		},
		{
			"header": "Coolant Temp",
			"unit": "°C",
			"offset": 11,
			"mul": 1,
			"add": -48
		},
		{
			"header": "Oil Temp",
			"unit": "°C",
			"offset": 12,
			"mul": 1,
			"add": -48
		},
		{
			"header": "Radiator Temp",
			"unit": "°C",
			"offset": 13,
			"mul": 1,
			"add": -48
		},
		{
			"header": "EGT",
			"unit": "°C",
			"offset": 14,
			"max": 1500
		},
		{
			"header": "Ambient Temp",
			"unit": "°C",
			"offset": 15,
			"add": -48,
			"max": 160
		},
		{
			"header": "Battery Voltage",
			"alias": "Battery",
			"unit": "V",
			"offset": 16,
			"mul": 0.1
		},
		{
			"header": "Master Power",
			"unit": "V",
			"offset": 17,
			"mul": 0.0391
		},
		{
			"header": "Slave Power",
			"unit": "V",
			"offset": 18,
			"mul": 0.0391
		},
		{
			"header": "Ambient Pressure",
			"unit": "Bar",
			"offset": 19,
			"mul": 0.003,
			"add": 500
		},
		{
			"header": "Rel Open Cross Sec",
			"unit": "%",
			"offset": 20,
			"length": 2,
			"mul": 0.0030518,
			"max": 120
		},
		{
			"header": "Accelerator Pedal 1",
			"unit": "%",
			"length": 2,
			"offset": 23,
			"mul": 0.1
		},
		{
			"header": "Accelerator Pedal 2",
			"unit": "%",
			"length": 2,
			"offset": 25,
			"mul": 0.1
		}
	]
}
