{
    "canSpeed": 500,
    "address": ["0x12", "0x05", "0x0B", "0x03", "0x1F"],
    // Preserve the original CAN11h calibration. Load the chassis definition first.
    // The first Speed CAN Raw holder wins; helper-alone behavior is also retained.
    "ecuparam": [
        {
            "header": "Rear Tire Width", "unit": "mm", "expr": "255",
            "hidden": true, "noLog": true
        },
        {
            "header": "Rear Tire Aspect Ratio", "expr": "40",
            "hidden": true, "noLog": true
        },
        {
            "header": "Rear Wheel Diameter", "unit": "in", "expr": "18",
            "hidden": true, "noLog": true
        },
        {
            "header": "Final Drive Ratio", "expr": "3.62",
            "hidden": true, "noLog": true
        },
        {
            "header": "CAN Raw to KPH Constant", "expr": "0.0000977",
            "hidden": true, "noLog": true
        },
        {
            "header": "CAN Raw to MPH Constant", "expr": "0.0000607",
            "hidden": true, "noLog": true
        },
        {
            "header": "Speed CAN Raw", "canId": "0x153",
            "offset": 1, "length": 2,
            "hidden": true, "noLog": true
        },
        {
            "header": "Rear Tire Circumference",
            "unit": "mm",
            "x": "Rear Tire Width",
            "y": "Rear Tire Aspect Ratio",
            "z": "Rear Wheel Diameter",
            "expr": "(2 * x * 0.01 * y + z * 25.4) * 3.1415",
            // For inches: (2 * (x / 25.4) * 0.01 * y + z) * 3.1415
            "hidden": true,
            "noLog": true
        },
        {
            "header": "Drivetrain Ratio",
            "x": "Rear Tire Circumference",
            "y": "Final Drive Ratio",
            "expr": "(x / y) * (60 / 1000000)",
            // For mph/inches: (x / y) * (60 / 63360)
            "hidden": true,
            "noLog": true
        },
        {
            "header": "Vehicle Speed",
            "unit": "km/h",
            "x": "Speed CAN Raw",
            "y": "Rear Tire Circumference",
            "z": "CAN Raw to KPH Constant",
            // For mph, use the MPH coefficient with circumference still in mm.
            "expr": "x * y * z",
            "dec": 0
        }
    ]
}
