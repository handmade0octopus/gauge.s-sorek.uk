{
    // Load after the chassis/ECU/OBD source. Existing Fuel usage (l/h) wins.
    // Fallback below is for six-cylinder port injection with 250 cc/min injectors.
    // Change 250 for your injectors: 180 for 320i/323i/325i, 280 for 330i.
    // Do not apply this pulse-width estimate to diesel/direct injection.
    "ecuparam": [
        {
            "header": "Fuel usage",
            "unique": true,
            "unit": "l/h",
            "expr": "(x/60)*(y/1000)*(250/16.6667)*3",
            "x": "Engine Speed",
            "y": "Fuel Inj"
        },
        {
            "header": "Economy",
            "unit": "l/100km",
            "expr": "clip(100*x/(y+0.1))",
            "x": "Fuel usage",
            "y": "Vehicle Speed"
        },
        {
            "header": "Econ avg 1",
            "unit": "l/100km",
            "expr": "avg(\"Econ avg 1\",x, y)",
            "x": "Economy",
            "y": "Vehicle Speed",
            "avgLen": 20.0
        },
        {
            "header": "Econ avg 2",
            "unit": "l/100km",
            "expr": "avg(\"Econ avg 2\",x, y)",
            "x": "Economy",
            "y": "Vehicle Speed",
            "avgLen": 20.0
        }
    ]
}
