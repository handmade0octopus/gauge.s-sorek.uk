{
    "_description": "Haltech Nexus/Elite ECU Broadcast CAN Protocol v2.0 - core dash channels",
    "_notes": [
        "Haltech Broadcast CAN Protocol v2.0 (requires Nexus 1.25+ / Elite 3.11+), formerly Haltech CAN Dash Protocol",
        "Bus: 1 Mbit/s, 11-bit IDs, big-endian data (reverseEndianness set on all multi-byte params)",
        "Pressures broadcast absolute in kPa, converted to Bar; relative channels subtract 101.3 kPa (add -1.013)",
        "Temperatures broadcast in Kelvin (x/10), converted to degC (add -273.15)",
        "Full channel set incl. diagnostics, TPMS and motorsport channels: haltech-full.json"
    ],
    "canSpeed": 1000,
    "ecuparam": [
        {
            "header": "Engine Speed",
            "unit": "RPM",
            "canId": "0x360",
            "offset": 0,
            "length": 2,
            "reverseEndianness": true,
            "dec": 0
        },
        {
            "header": "MAP",
            "unit": "Bar",
            "canId": "0x360",
            "offset": 2,
            "length": 2,
            "reverseEndianness": true,
            "mul": 0.001
        },
        {
